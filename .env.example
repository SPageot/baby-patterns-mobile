# Phone/emulator cannot use localhost — use your PC's LAN IP (ipconfig → IPv4).
# Android emulator alternative: http://10.0.2.2:5251
# Production API: https://baby-patterns-server.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.1.179:5251
EXPO_PUBLIC_MEDIA_URL=https://baby-patterns-server.onrender.com

# Allow HTTP (cleartext) for local API on Android. Set true for local dev only.
# EAS development profile sets this automatically. Omit or false for production.
EXPO_PUBLIC_ALLOW_CLEARTEXT=true
